{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static files only: there is no Worker script.
  "name": "rollbard",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./build/client",
    "not_found_handling": "404-page",
  },
}
